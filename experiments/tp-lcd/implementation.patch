+                      cl::desc("Override experimental slide startup cost"));
+static cl::opt<unsigned> TPLCDSlideQuadraticCost(
+    "riscv-tp-lcd-slide-quadratic-cost", cl::Hidden, cl::init(0),
+    cl::desc(
