+  case TPLCDProfile::None:
+    return nullptr;
+  case TPLCDProfile::XiangShan:
+    return &XiangShan;
+  case TPLCDProfile::Saturn:
+    return &Saturn;
+  }
+  llvm_unreachable("invalid TP/LCD profile");
