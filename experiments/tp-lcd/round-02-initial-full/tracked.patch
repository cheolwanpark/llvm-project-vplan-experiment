+  if (VT.isScalableVector())
+    Bits *= VScale;
+  uint64_t Beats = divideCeil(Bits, Tune.BeatBits);
+  return Beats + (Kind == TTI::TCK_Latency ? Tune.LatencyStartup : 0);
+}
